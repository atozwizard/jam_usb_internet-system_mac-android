  fi

  "$python_bin" "$proxy_script" --host "$PROXY_HOST" --port "$PROXY_PORT" --adb "$ADB_BIN" --serial "$ADB_SERIAL" &
  proxy_pid=$!
  print -r -- "$proxy_pid" > "$PROXY_PID_FILE"

  cleanup_browser_proxy() {
    kill "$proxy_pid" >/dev/null 2>&1 || true
    rm -f "$PROXY_PID_FILE"
  }
  trap 'cleanup_browser_proxy' INT TERM HUP EXIT

  if ! wait_for_proxy_port; then
    fail "SOCKS proxy did not start on ${PROXY_HOST}:${PROXY_PORT}."
    cleanup_browser_proxy
    return 1
  fi

  launch_chrome_with_proxy || {
    cleanup_browser_proxy
    return 1
  }

  say ""
  ok "Dedicated Chrome window is using the phone over USB."
  info "Keep this terminal window open. Close it to stop the proxy."
  info "This browser mode works even when Mac Wi-Fi is on but not connected."
  say ""

  wait "$proxy_pid"
}

proxy_stop_command() {
  restore_system_socks_proxy
  local service current_server current_port
  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    current_server="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Server:/ {print $2; exit}')"
    current_port="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Port:/ {print $2; exit}')"
    if [[ "$current_server" == "$PROXY_HOST" && "$current_port" == "$PROXY_PORT" ]]; then
      networksetup -setsocksfirewallproxystate "$service" off >/dev/null 2>&1 || true
    fi
  done < <(all_network_services)

  if [[ -s "$PROXY_PID_FILE" ]]; then
    local pid
    pid="$(< "$PROXY_PID_FILE")"
    if [[ -n "$pid" ]]; then
      kill "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$PROXY_PID_FILE"
  fi

  pkill -f "adb-socks-proxy.py" >/dev/null 2>&1 || true
}

relay_binary_for_abi() {
  local abi="$1"
  local explicit="${KNOCK_RELAY_BINARY:-}"
  local candidate

  if [[ -n "$explicit" ]]; then
    print -r -- "$explicit"
    return 0
  fi

  case "$abi" in
    arm64-v8a)
      candidate="${SCRIPT_DIR}/android-relay/bin/arm64-v8a/knock-relay"
      ;;
    armeabi-v7a)
      candidate="${SCRIPT_DIR}/android-relay/bin/armeabi-v7a/knock-relay"
      ;;
    x86_64)
      candidate="${SCRIPT_DIR}/android-relay/bin/x86_64/knock-relay"
      ;;
    *)
      candidate="${SCRIPT_DIR}/android-relay/bin/${abi}/knock-relay"
      ;;
  esac

  print -r -- "$candidate"
}

relay_install_command() {
  local abi relay_binary

  require_macos
  ensure_adb_device_or_fail || return 1

  abi="$(android_abi)"
  if [[ -z "$abi" ]]; then
    fail "Could not detect Android ABI."
    return 1
  fi
  ok "Detected Android ABI: $abi"

  relay_binary="$(relay_binary_for_abi "$abi")"
  if [[ ! -f "$relay_binary" ]]; then
    fail "Relay binary is missing: $relay_binary"
    say ""
    say "Build it with: cd ${SCRIPT_DIR}/android-relay && ./build.sh"
    say "Expected install target: ${RELAY_REMOTE_PATH}"
    say "Override path later with: --relay-binary /path/to/knock-relay"
    return 1
  fi

  info "Uploading relay binary to ${RELAY_REMOTE_PATH}"
  adb_cmd push "$relay_binary" "$RELAY_REMOTE_PATH" >/dev/null || return 1
  adb_shell "chmod 755 ${RELAY_REMOTE_PATH}" >/dev/null || return 1

  ok "Relay installed at ${RELAY_REMOTE_PATH}"
}

relay_is_installed() {
  adb_shell "[ -x '${RELAY_REMOTE_PATH}' ]" >/dev/null 2>&1
}

relay_start_command() {
  local output

  require_macos
  ensure_adb_device_or_fail || return 1

  if ! relay_is_installed; then
    fail "Relay is not installed at ${RELAY_REMOTE_PATH}."
    say "Run relay-install after the Stage 2 relay binary exists."
    return 1
  fi

  info "Removing any old ADB forward on tcp:${RELAY_MAC_PORT}."
  adb_cmd forward --remove "tcp:${RELAY_MAC_PORT}" >/dev/null 2>&1 || true

  info "Starting Android relay on 127.0.0.1:${RELAY_DEVICE_PORT}."
  adb_shell "pkill -f '${RELAY_REMOTE_PATH}' >/dev/null 2>&1 || true" >/dev/null 2>&1 || true
  output="$(adb_shell "nohup '${RELAY_REMOTE_PATH}' --listen 127.0.0.1:${RELAY_DEVICE_PORT} > '${RELAY_REMOTE_LOG}' 2>&1 & echo \$!" 2>&1)"
  debug "$output"

  sleep 1

  info "Creating ADB forward: Mac tcp:${RELAY_MAC_PORT} -> Android tcp:${RELAY_DEVICE_PORT}"
  adb_cmd forward "tcp:${RELAY_MAC_PORT}" "tcp:${RELAY_DEVICE_PORT}" || return 1

  ok "Relay forward is ready on 127.0.0.1:${RELAY_MAC_PORT}"
  say "Check with: adb forward --list"
}

relay_stop_command() {
  require_macos
  if start_adb_if_available; then
    if select_adb_device_now; then
      adb_shell "pkill -f '${RELAY_REMOTE_PATH}' >/dev/null 2>&1 || true" >/dev/null 2>&1 || true
      ok "Stopped Android relay if it was running."
    else
      warn "No ADB device available; removing local forward only."
    fi
    adb_cmd forward --remove "tcp:${RELAY_MAC_PORT}" >/dev/null 2>&1 || true
  else
    warn "ADB is not available; could not remove ADB forward."
  fi

  ok "Removed ADB forward tcp:${RELAY_MAC_PORT} if it existed."
}

relay_clean_command() {
  relay_stop_command || true

  if start_adb_if_available && wait_for_adb_device; then
    adb_shell "rm -f '${RELAY_REMOTE_PATH}' '${RELAY_REMOTE_LOG}'" >/dev/null 2>&1 || true
    ok "Removed relay files from Android."
  else
    warn "No ADB device available; could not remove Android relay files."
  fi
}

stop_sing_box_processes() {
  local pid args

  if [[ -s "$SING_BOX_PID_FILE" ]]; then
    pid="$(< "$SING_BOX_PID_FILE")"
    if [[ -n "$pid" ]]; then
      kill "$pid" >/dev/null 2>&1 || run_privileged kill "$pid" >/dev/null 2>&1 || true
    fi
    rm -f "$SING_BOX_PID_FILE"
  fi

  while IFS= read -r pid; do
    [[ -z "$pid" ]] && continue
    args="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    [[ "$args" == *"$SING_BOX_CONFIG"* ]] || continue
    kill "$pid" >/dev/null 2>&1 || run_privileged kill "$pid" >/dev/null 2>&1 || true
  done < <(pgrep -x sing-box 2>/dev/null || true)
}

sing_box_pid_for_config() {
  local pid args

  for pid in ${(f)"$(pgrep -x sing-box 2>/dev/null || true)"}; do
    [[ -z "$pid" ]] && continue
    args="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    if [[ "$args" == *"$SING_BOX_CONFIG"* ]]; then
      print -r -- "$pid"
      return 0
    fi
  done

  return 1
}

print_sing_box_log_tail() {
  local line

  [[ -s "$SING_BOX_LOG" ]] || return 0
  warn "sing-box log (last 20 lines): $SING_BOX_LOG"
  tail -20 "$SING_BOX_LOG" 2>/dev/null | while IFS= read -r line; do
    [[ -n "$line" ]] && warn "  $line"
  done
}

start_sing_box_engine() {
  local sing_box_bin="$1"
  local i real_pid

  : > "$SING_BOX_LOG"

  if (( EUID == 0 )); then
    (
      "$sing_box_bin" run -c "$SING_BOX_CONFIG"
    ) >> "$SING_BOX_LOG" 2>&1 &
  else
    (
      run_privileged "$sing_box_bin" run -c "$SING_BOX_CONFIG"
    ) >> "$SING_BOX_LOG" 2>&1 &
  fi

  for (( i = 1; i <= 40; i++ )); do
    if real_pid="$(sing_box_pid_for_config)"; then
      print -r -- "$real_pid" > "$SING_BOX_PID_FILE"
      ok "Started sing-box (pid ${real_pid}). Log: $SING_BOX_LOG"
      return 0
    fi
    sleep 0.25
  done

  print_sing_box_log_tail
  fail "sing-box did not stay running."
  return 1
}

wait_for_process_exit() {
  local pid="$1"

  [[ -n "$pid" ]] || return 0
  while process_is_running "$pid"; do
    sleep 1
  done
}

process_is_running() {
  local pid="$1"

  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  ps -p "$pid" >/dev/null 2>&1
}

wait_for_sing_box_exit() {
  while sing_box_pid_for_config >/dev/null 2>&1; do

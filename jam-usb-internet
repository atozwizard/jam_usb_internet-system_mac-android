}

check_relay_https_endpoint() {
  local label="$1"
  local url="$2"
  local code

  code="$(curl --socks5-hostname "127.0.0.1:${RELAY_MAC_PORT}" -4I -L --max-time 15 -sS -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || true)"
  if [[ "$code" =~ '^[234][0-9][0-9]$' ]]; then
    ok "$label reachable through Android relay ($code): $url"
    return 0
  fi

  fail "$label failed through Android relay (${code:-no response}): $url"
  return 1
}


  if GIT_TERMINAL_PROMPT=0 git -c "http.proxy=socks5h://127.0.0.1:${RELAY_MAC_PORT}" -c http.lowSpeedLimit=1 -c http.lowSpeedTime=10 ls-remote https://github.com/git/git.git HEAD >/dev/null 2>&1; then
    ok "git over HTTPS reachable through Android relay: github.com/git/git.git"
    return 0
  fi

  fail "git over HTTPS failed through Android relay: github.com/git/git.git"
  return 1
}


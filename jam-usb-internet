  ok "System mode stop requested."
}

check_https_endpoint() {
  local label="$1"
  local url="$2"
  local code

  code="$(curl -4I -L --max-time 12 -sS -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || true)"
  if [[ "$code" =~ '^[234][0-9][0-9]$' ]]; then
    ok "$label HTTPS reachable ($code): $url"
    return 0
  fi

  fail "$label HTTPS failed (${code:-no response}): $url"
  return 1
}

check_tcp_endpoint() {
  local label="$1"
  local host="$2"
  local port="$3"

  if nc -4 -G 8 -z "$host" "$port" >/dev/null 2>&1; then
    ok "$label TCP reachable: ${host}:${port}"
    return 0
  fi

  fail "$label TCP failed: ${host}:${port}"
  return 1
}

check_reachability_endpoint() {
  local label="$1"
  local host="$2"
  local output

  output="$(scutil -r "$host" 2>&1 || true)"
  if [[ "$output" == *"Reachable"* && "$output" != *"Not Reachable"* ]]; then
    ok "$label macOS reachability: ${host} (${output})"
    return 0
  fi

  fail "$label macOS reachability failed: ${host} (${output:-no response})"
  return 1
}

check_git_endpoint() {
  if GIT_TERMINAL_PROMPT=0 GIT_HTTP_LOW_SPEED_LIMIT=1 GIT_HTTP_LOW_SPEED_TIME=8 git -c http.lowSpeedLimit=1 -c http.lowSpeedTime=8 ls-remote https://github.com/git/git.git HEAD >/dev/null 2>&1; then
    ok "git over HTTPS reachable: github.com/git/git.git"
    return 0
  fi

  fail "git over HTTPS failed: github.com/git/git.git"
  return 1
}

basic_network_check() {
  local mode="${1:-strict}"
  local failed=0

  if dig +time=3 +tries=1 example.com >/dev/null 2>&1 || nslookup example.com >/dev/null 2>&1; then
    ok "DNS works through current macOS resolver."
  else
    fail "DNS failed through current macOS resolver."
    failed=1
  fi

  check_https_endpoint "Chrome/web" "https://www.google.com/generate_204" || failed=1
  check_https_endpoint "Discord gateway API" "https://discord.com/api/v10/gateway" || failed=1
  check_tcp_endpoint "Discord gateway" "gateway.discord.gg" 443 || failed=1
  check_https_endpoint "Kakao" "https://talk.kakao.com" || failed=1
  check_tcp_endpoint "Kakao" "talk.kakao.com" 443 || failed=1
  if ! check_reachability_endpoint "KakaoTalk" "talk.kakao.com"; then
    if [[ "$mode" == "system" ]]; then
      warn "Keeping system mode up because DNS/TCP checks passed; KakaoTalk reachability remains a blocker for app-check."
    else
      failed=1
    fi
  fi
  check_git_endpoint || failed=1

  return "$failed"
}

system_recover_command() {

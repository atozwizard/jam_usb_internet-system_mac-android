save_default_route_once() {
  local gateway iface

  ensure_state_dir
  [[ -s "$DEFAULT_ROUTE_BACKUP" ]] && return 0

  gateway="$(default_route_gateway)"
  iface="$(default_route_interface)"
  if [[ -z "$gateway" && -z "$iface" ]]; then
    print -r -- "__NONE__"$'\t'"__NONE__" > "$DEFAULT_ROUTE_BACKUP"
  else
    print -r -- "${gateway:-__EMPTY__}"$'\t'"${iface:-__EMPTY__}" > "$DEFAULT_ROUTE_BACKUP"
  fi
}

install_tun_default_route() {
  local tun_if="$1"
  local output rc current_route

  save_default_route_once

  if route -n get default 2>/dev/null | grep -q "interface: ${tun_if}"; then
    ok "Temporary default route already points through ${tun_if}."
    return 0
  fi

  output="$(run_privileged route -n change default "$TUN_GATEWAY" 2>&1)"
  rc=$?
  if (( rc != 0 )); then
    debug "route change default failed: $output"
    run_privileged route -n delete default >/dev/null 2>&1 || true
    output="$(run_privileged route -n add default "$TUN_GATEWAY" 2>&1)"
    rc=$?
  fi

  if (( rc != 0 )) && [[ "$output" != *"File exists"* ]]; then
    warn "Could not install temporary default route through ${tun_if}: $output"
    return "$rc"
  fi

  if ! route -n get default 2>/dev/null | grep -q "interface: ${tun_if}"; then
    current_route="$(route -n get default 2>&1 | paste -sd ' ' -)"
    warn "Temporary default route verification failed for ${tun_if}: ${current_route}"
    output="$(run_privileged route -n add default -interface "$tun_if" 2>&1)"
    rc=$?
    if (( rc != 0 )) && [[ "$output" != *"File exists"* ]]; then
      debug "route add default interface failed: $output"
    fi
    if ! route -n get default 2>/dev/null | grep -q "interface: ${tun_if}"; then
      return 1
    fi
  fi

  ok "Installed temporary default route through ${tun_if} for macOS app reachability."
}

restore_default_route() {
  local tun_if="${1:-}"
  local line gateway iface output rc

  if [[ ! -s "$DEFAULT_ROUTE_BACKUP" ]]; then
    if [[ -n "$tun_if" ]] && route -n get default 2>/dev/null | grep -q "interface: ${tun_if}"; then
      run_privileged route -n delete default "$TUN_GATEWAY" >/dev/null 2>&1 || true
      run_privileged route -n delete default -interface "$tun_if" >/dev/null 2>&1 || true
    fi
    return 0
  fi

  line="$(< "$DEFAULT_ROUTE_BACKUP")"
  gateway="${line%%$'\t'*}"
  iface="${line#*$'\t'}"

  if [[ "$gateway" == "__NONE__" && "$iface" == "__NONE__" ]]; then
    if [[ -n "$tun_if" ]] && route -n get default 2>/dev/null | grep -q "interface: ${tun_if}"; then
      run_privileged route -n delete default "$TUN_GATEWAY" >/dev/null 2>&1 || true
      run_privileged route -n delete default -interface "$tun_if" >/dev/null 2>&1 || true
    fi
    rm -f "$DEFAULT_ROUTE_BACKUP"
    return 0
  fi

  if [[ "$gateway" != "__EMPTY__" ]]; then
    output="$(run_privileged route -n change default "$gateway" 2>&1)"
    rc=$?
    if (( rc != 0 )); then
      debug "route change default restore failed: $output"
      run_privileged route -n delete default >/dev/null 2>&1 || true
      output="$(run_privileged route -n add default "$gateway" 2>&1)"
      rc=$?
    fi
  elif [[ "$iface" != "__EMPTY__" ]]; then
    output="$(run_privileged route -n change default -interface "$iface" 2>&1)"
    rc=$?
    if (( rc != 0 )); then
      debug "route change default interface restore failed: $output"
      run_privileged route -n delete default >/dev/null 2>&1 || true
      output="$(run_privileged route -n add default -interface "$iface" 2>&1)"
      rc=$?
    fi
  else
    rc=0
  fi

  if (( rc != 0 )); then
    warn "Could not restore previous default route: $output"
    warn "Default route backup kept for recovery: $DEFAULT_ROUTE_BACKUP"
    return "$rc"
  fi

  rm -f "$DEFAULT_ROUTE_BACKUP"
  ok "Restored previous default route."
}

install_manual_tun_routes() {
  local prefix tun_if output rc failed=0

  tun_if="$(current_tun_interface)"
  if [[ -z "$tun_if" ]]; then
    fail "Could not identify the TUN interface for ${TUN_GATEWAY}."
    return 1
  fi

  info "Installing IPv4 split routes through ${tun_if}."

  if ! install_tun_default_route "$tun_if"; then
    warn "Continuing without a verified default route; TCP/DNS may still work through split routes."
    warn "Apps that rely on macOS reachability, especially KakaoTalk, may still report offline."
  fi

  while IFS= read -r prefix; do
    [[ -z "$prefix" ]] && continue
    output="$(run_privileged route -n add -net "$prefix" -interface "$tun_if" 2>&1)"
    rc=$?
    if (( rc != 0 )) && [[ "$output" != *"File exists"* ]]; then
      warn "Could not add route ${prefix} through ${tun_if}: $output"
      failed=1
    fi
  done < <(manual_route_prefixes)

  if ! route -n get 1.1.1.1 2>/dev/null | grep -q "interface: ${tun_if}"; then
    fail "Route verification failed: 1.1.1.1 is not routed through ${tun_if}."
    return 1
  fi

  ok "IPv4 route verification passed through ${tun_if}."
  (( failed == 0 ))
}

delete_manual_tun_routes() {
  local prefix tun_if default_route

  tun_if="$(current_tun_interface)"
  restore_default_route "$tun_if" || true

  while IFS= read -r prefix; do
    [[ -z "$prefix" ]] && continue
    if [[ -n "$tun_if" ]]; then
      run_privileged route -n delete -net "$prefix" -interface "$tun_if" >/dev/null 2>&1 || true
    fi
    run_privileged route -n delete -net "$prefix" >/dev/null 2>&1 || true
  done < <(manual_route_prefixes)

  default_route="$(route -n get default 2>/dev/null || true)"
  if print -r -- "$default_route" | grep -q "gateway: ${TUN_GATEWAY}"; then
    run_privileged route -n delete default "$TUN_GATEWAY" >/dev/null 2>&1 || true
    run_privileged route -n delete default >/dev/null 2>&1 || true
  fi
}

system_local_cleanup_once() {
  local include_remote="${1:-remote}"

  delete_manual_tun_routes
  disable_dynamic_local_dns
  if ! restore_system_dns; then
    warn "DNS restore failed during cleanup; stale local DNS repair was attempted."
  fi
  repair_stale_local_socks_proxy
  stop_sing_box_processes
  if [[ "$include_remote" == "remote" ]]; then
    relay_stop_command || true
    if [[ -s "$SOCKS_BACKUP" || -s "$PROXY_PID_FILE" ]]; then
      proxy_stop_command || true
    fi
  fi
  dscacheutil -flushcache >/dev/null 2>&1 || true
}

normal_network_state_is_clean() {
  if dns_servers_are_local_only "$(dns_servers_for_service Wi-Fi)"; then
    return 1
  fi
  if scutil --dns 2>/dev/null | grep -Eq 'nameserver\[[0-9]+\] : 127\.0\.0\.1'; then
    return 1
  fi
  if netstat -rn -f inet | awk '$1 == "1" || $1 == "1.0.0.0/8" || $1 == "128.0/1" {print}' | grep -q "$TUN_GATEWAY"; then
    return 1
  fi
  if route -n get default 2>/dev/null | grep -q "gateway: ${TUN_GATEWAY}"; then
    return 1
  fi
  return 0
}

guard_recovery_watch() {
  local attempts="${1:-24}"
  local delay="${2:-5}"
  local i

  for (( i = 1; i <= attempts; i++ )); do
    system_local_cleanup_once local
    if normal_network_state_is_clean && quick_internet_check; then
      ok "Cleanup guard verified normal internet after ${i} recovery pass(es)."
      return 0
    fi
    sleep "$delay"
  done

  warn "Cleanup guard finished repeated repair, but normal internet was not verified."
}


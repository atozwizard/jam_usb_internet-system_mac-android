system_guard_session_matches() {
  local expected_token="$1"
  local line current_token

  [[ -s "$SYSTEM_SESSION_FILE" ]] || return 1
  line="$(< "$SYSTEM_SESSION_FILE")"
  current_token="${line%%$'\t'*}"
  [[ "$current_token" == "$expected_token" ]]
}

system_guard_disarmed() {
  local expected_token="$1"
  local disarm_token

  [[ -s "$SYSTEM_GUARD_DISARM_FILE" ]] || return 1
  disarm_token="$(< "$SYSTEM_GUARD_DISARM_FILE")"
  [[ "$disarm_token" == "$expected_token" ]]
}

remove_guard_launchctl_label() {
  local label="$1"

  [[ -n "$label" ]] || return 0
  launchctl remove "$label" >/dev/null 2>&1 || true
  run_privileged launchctl remove "$label" >/dev/null 2>&1 || true
}

remove_stale_guard_jobs() {
  local label

  while IFS= read -r label; do
    [[ -z "$label" ]] && continue
    remove_guard_launchctl_label "$label"
  done < <(
    {
      launchctl list 2>/dev/null || true
      run_privileged launchctl list 2>/dev/null || true
    } | awk '/com\.atozwizard\.jam-usb-internet\.guard\./ {print $3}' | sort -u
  )
}

system_guard_log_parent() {
  local message="$*"

  print -r -- "$(date '+%Y-%m-%d %H:%M:%S') parent: ${message}" >> "$SYSTEM_GUARD_LOG" 2>/dev/null || true
}

system_guard_pid_is_ready() {
  local guard_pid

  [[ -s "$SYSTEM_GUARD_PID_FILE" ]] || return 1
  guard_pid="$(< "$SYSTEM_GUARD_PID_FILE")"
  if [[ "$guard_pid" == <-> ]] && kill -0 "$guard_pid" >/dev/null 2>&1; then
    return 0
  fi
  rm -f "$SYSTEM_GUARD_PID_FILE"
  return 1
}

wait_for_system_guard_ready() {
  local attempts="${1:-100}"
  local delay="${2:-0.1}"
  local launcher_pid="${3:-}"
  local i

  for (( i = 1; i <= attempts; i++ )); do
    if system_guard_pid_is_ready; then
      return 0
    fi
    if [[ -n "$launcher_pid" ]] && ! kill -0 "$launcher_pid" >/dev/null 2>&1; then
      system_guard_log_parent "fallback launcher exited before guard became ready (pid ${launcher_pid})"
      return 1
    fi
    sleep "$delay"
  done
  return 1
}

launch_system_guard_nohup() {
  local parent_pid="$1"
  local token="$2"

  if (( EUID == 0 )); then
    /usr/bin/nohup /usr/bin/env "JAM_USB_STATE_DIR=$STATE_DIR" "$SCRIPT_DIR/jam-usb-internet" system-guard \
      --guard-parent-pid "$parent_pid" \
      --guard-token "$token" \
      >> "$SYSTEM_GUARD_LOG" 2>&1 </dev/null &
  else
    run_privileged /usr/bin/nohup /usr/bin/env "JAM_USB_STATE_DIR=$STATE_DIR" "$SCRIPT_DIR/jam-usb-internet" system-guard \
      --guard-parent-pid "$parent_pid" \
      --guard-token "$token" \
      >> "$SYSTEM_GUARD_LOG" 2>&1 </dev/null &
  fi
  SYSTEM_GUARD_LAUNCHER_PID=$!
}

start_system_guard() {
  local parent_pid token launcher_pid="" guard_pid label output rc

  ensure_state_dir
  parent_pid="$$"
  token="${parent_pid}-$(date +%s)-${RANDOM}"
  label="com.atozwizard.jam-usb-internet.guard.${parent_pid}"
  remove_stale_guard_jobs
  print -r -- "$token"$'\t'"$parent_pid" > "$SYSTEM_SESSION_FILE"
  print -r -- "$label" > "$SYSTEM_GUARD_LABEL_FILE"
  touch "$SYSTEM_GUARD_LOG" >/dev/null 2>&1 || true
  rm -f "$SYSTEM_GUARD_PID_FILE" "$SYSTEM_GUARD_DISARM_FILE"
  system_guard_log_parent "starting cleanup guard for parent ${parent_pid}"
  system_guard_log_parent "state_dir=${STATE_DIR}"
  system_guard_log_parent "script=${SCRIPT_DIR}/jam-usb-internet"

  output="$(
    run_privileged launchctl submit \
      -l "$label" \
      -o "$SYSTEM_GUARD_LOG" \
      -e "$SYSTEM_GUARD_LOG" \
      -- /usr/bin/env "JAM_USB_STATE_DIR=$STATE_DIR" "$SCRIPT_DIR/jam-usb-internet" system-guard \
        --guard-parent-pid "$parent_pid" \
        --guard-token "$token" 2>&1
  )"
  rc=$?
  system_guard_log_parent "launchctl submit rc=${rc} output=${output:-<empty>}"
  if (( rc == 0 )); then
    if wait_for_system_guard_ready 100 0.1; then
      guard_pid="$(< "$SYSTEM_GUARD_PID_FILE")"
      ok "Started abnormal-exit cleanup guard (pid ${guard_pid}, label ${label})."
      return 0
    fi
    system_guard_log_parent "launchctl guard did not become ready within 10 seconds; trying nohup fallback"
  else
    debug "launchctl guard submit failed: $output"
    warn "launchctl guard submit failed: ${output:-unknown error}"
    system_guard_log_parent "launchctl submit failed; trying nohup fallback"
  fi

  remove_guard_launchctl_label "$label"
  rm -f "$SYSTEM_GUARD_PID_FILE"
  launch_system_guard_nohup "$parent_pid" "$token"
  launcher_pid="$SYSTEM_GUARD_LAUNCHER_PID"
  system_guard_log_parent "nohup fallback launcher pid=${launcher_pid:-<empty>}"
  if wait_for_system_guard_ready 100 0.1 "$launcher_pid"; then
    guard_pid="$(< "$SYSTEM_GUARD_PID_FILE")"
    ok "Started abnormal-exit cleanup guard fallback (pid ${guard_pid})."
    return 0
  fi

  rm -f "$SYSTEM_SESSION_FILE"
  remove_guard_launchctl_label "$label"
  system_guard_log_parent "cleanup guard startup failed after launchctl and nohup attempts"
  warn "Could not start abnormal-exit cleanup guard. See: $SYSTEM_GUARD_LOG"
  tail -20 "$SYSTEM_GUARD_LOG" 2>/dev/null || true
  return 1
}

disarm_system_guard() {
  local guard_pid label

  if [[ -s "$SYSTEM_SESSION_FILE" ]]; then
    print -r -- "$(< "$SYSTEM_SESSION_FILE")" | awk -F'\t' '{print $1}' > "$SYSTEM_GUARD_DISARM_FILE"
  fi
  rm -f "$SYSTEM_SESSION_FILE"
  if [[ -s "$SYSTEM_GUARD_LABEL_FILE" ]]; then
    label="$(< "$SYSTEM_GUARD_LABEL_FILE")"
    remove_guard_launchctl_label "$label"
    rm -f "$SYSTEM_GUARD_LABEL_FILE"
  fi
  remove_stale_guard_jobs
  if [[ -s "$SYSTEM_GUARD_PID_FILE" ]]; then
    guard_pid="$(< "$SYSTEM_GUARD_PID_FILE")"
    if [[ -n "$guard_pid" && "$guard_pid" != "$$" ]]; then
      kill "$guard_pid" >/dev/null 2>&1 || run_privileged kill "$guard_pid" >/dev/null 2>&1 || true
    fi
    rm -f "$SYSTEM_GUARD_PID_FILE"
  fi
}

system_guard_command() {
  local parent_pid="$GUARD_PARENT_PID"
  local token="$GUARD_TOKEN"
  local label=""

  require_macos
  ensure_state_dir

  if [[ -z "$parent_pid" || -z "$token" ]]; then
    fail "system-guard requires --guard-parent-pid and --guard-token."
    return 2
  fi

  print -r -- "$$" > "$SYSTEM_GUARD_PID_FILE"
  [[ -s "$SYSTEM_GUARD_LABEL_FILE" ]] && label="$(< "$SYSTEM_GUARD_LABEL_FILE")"
  say "$(date '+%Y-%m-%d %H:%M:%S') cleanup guard started for parent ${parent_pid}"

  while kill -0 "$parent_pid" >/dev/null 2>&1; do
    if system_guard_disarmed "$token"; then
      say "$(date '+%Y-%m-%d %H:%M:%S') cleanup guard disarmed"
      rm -f "$SYSTEM_GUARD_PID_FILE"
      remove_guard_launchctl_label "$label"
      return 0
    fi
    sleep 2
  done

  sleep 1
  if system_guard_disarmed "$token"; then
    say "$(date '+%Y-%m-%d %H:%M:%S') cleanup guard disarmed after parent exit"
    rm -f "$SYSTEM_GUARD_PID_FILE"
    remove_guard_launchctl_label "$label"
    return 0
  fi

  warn "System session exited without disarming cleanup guard; recovering normal networking."
  system_local_cleanup_once remote
  guard_recovery_watch
  rm -f "$SYSTEM_SESSION_FILE" "$SYSTEM_GUARD_PID_FILE" "$SYSTEM_GUARD_DISARM_FILE" "$SYSTEM_GUARD_LABEL_FILE"
  ok "Cleanup guard finished."
  remove_guard_launchctl_label "$label"
}

guard_check_command() {
  require_macos
  ensure_state_dir
  jam_usb_export_askpass

  if (( EUID != 0 )); then
    if ! ensure_admin_for_system; then
      fail "Administrator permission is required for cleanup guard check."
      return 1
    fi
    ok "Administrator credentials cached for cleanup guard check."
  fi

  if ! start_system_guard; then
    fail "Cleanup guard check failed."
    return 1
  fi
  sleep 1
  disarm_system_guard
  clear_sudo_askpass_cache
  ok "Cleanup guard check passed."
}


#!/bin/zsh
#
# jam-usb-internet
# Mac + Android USB internet helper for situations where Wi-Fi/Bluetooth are not usable.
#
# Preferred path: keep ADB alive in File Transfer mode, run an Android relay,
# and route Mac traffic through a local TUN engine. Native USB tethering remains
# available as an explicit compatibility experiment through `connect`.

set -u

export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:${PATH:-}"

APP_NAME="jam-usb-internet"
VERSION="0.4.7"
SCRIPT_DIR="${0:a:h}"
STATE_DIR="${JAM_USB_STATE_DIR:-${HOME}/.jam-usb-internet}"
ORDER_BACKUP="${STATE_DIR}/network-services.before"
SOCKS_BACKUP="${STATE_DIR}/socks-proxy.before"
DNS_BACKUP="${STATE_DIR}/dns-servers.before"
DEFAULT_ROUTE_BACKUP="${STATE_DIR}/default-route.before"
PROXY_PID_FILE="${STATE_DIR}/adb-socks.pid"
RELAY_REMOTE_PATH="/data/local/tmp/knock-relay"
RELAY_REMOTE_LOG="/data/local/tmp/knock-relay.log"
RELAY_MAC_PORT=18080
RELAY_DEVICE_PORT=18080
SING_BOX_CONFIG="${STATE_DIR}/sing-box.system.json"
SING_BOX_PID_FILE="${STATE_DIR}/sing-box.pid"
SING_BOX_LOG="${STATE_DIR}/sing-box.log"
SYSTEM_GUARD_PID_FILE="${STATE_DIR}/system-guard.pid"
SYSTEM_SESSION_FILE="${STATE_DIR}/system-session"
SYSTEM_GUARD_DISARM_FILE="${STATE_DIR}/system-guard.disarm"
SYSTEM_GUARD_LOG="${STATE_DIR}/system-guard.log"
SYSTEM_GUARD_LABEL_FILE="${STATE_DIR}/system-guard.label"
TUN_GATEWAY="172.19.0.1"
DYNAMIC_DNS_KEY="State:/Network/Service/jam-usb-internet/DNS"

COMMAND="connect"
TIMEOUT=45
USE_ADB=1
OPEN_SETTINGS=1
MOBILE_ONLY=0
PREFER_TETHER=1
AGGRESSIVE_ANDROID=0
VERBOSE=0
FALLBACK_PROXY=0
SYSTEM_PROXY=1
PROXY_HOST="127.0.0.1"
PROXY_PORT=10808
BROWSER_URL="https://example.com"
CHECK_ONLY=0
FORCE_TUN=0
GUARD_PARENT_PID=""
GUARD_TOKEN=""
SYSTEM_GUARD_LAUNCHER_PID=""
JSON_OUTPUT=0

ADB_BIN=""
ADB_SERIAL="${ANDROID_SERIAL:-}"

if [[ -t 1 ]]; then
  BOLD="$(tput bold 2>/dev/null || true)"
  DIM="$(tput dim 2>/dev/null || true)"
  RED="$(tput setaf 1 2>/dev/null || true)"
  GREEN="$(tput setaf 2 2>/dev/null || true)"
  YELLOW="$(tput setaf 3 2>/dev/null || true)"
  BLUE="$(tput setaf 4 2>/dev/null || true)"
  RESET="$(tput sgr0 2>/dev/null || true)"
else
  BOLD=""
  DIM=""
  RED=""
  GREEN=""
  YELLOW=""
  BLUE=""
  RESET=""
fi

say() { print -r -- "$*"; }
info() { say "${BLUE}[info]${RESET} $*"; }
ok() { say "${GREEN}[ok]${RESET} $*"; }
warn() { say "${YELLOW}[warn]${RESET} $*"; }
fail() { say "${RED}[fail]${RESET} $*"; }
debug() { (( VERBOSE )) && say "${DIM}[debug] $*${RESET}"; }

json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/}"
  print -r -- "$s"
}

json_bool() {
  (( $1 )) && print -r -- "true" || print -r -- "false"
}

json_string_or_null() {
  local value="$1"
  if [[ -n "$value" ]]; then
    print -r -- "\"$(json_escape "$value")\""
  else
    print -r -- "null"
  fi
}

sing_box_running() {
  sing_box_pid_for_config >/dev/null 2>&1
}

dns_temp_active() {
  scutil --dns 2>/dev/null | awk '
    /nameserver\[[0-9]+\] : 127\.0\.0\.1/ { found = 1 }
    END { exit(found ? 0 : 1) }
  '
}

relay_running_now() {
  if start_adb_if_available && select_adb_device_now; then
    adb_shell "pidof knock-relay" 2>/dev/null | tr -d '\r' | grep -q .
  else
    return 1
  fi
}

adb_forward_active() {
  if start_adb_if_available; then
    adb_cmd forward --list 2>/dev/null | grep -q "tcp:${RELAY_MAC_PORT}"
  else
    return 1
  fi
}

route_interface_for_public() {
  route -n get 1.1.1.1 2>/dev/null | awk -F': ' '/^  interface:/ {print $2; exit}'
}

collect_adb_json_state() {
  local found=0 authorized=0 serial="" adb_path="" model="" manufacturer=""
  if adb_path="$(find_adb)"; then
    found=1
    if start_adb_if_available && select_adb_device_now; then
      authorized=1
      serial="$ADB_SERIAL"
      model="$(adb_shell "getprop ro.product.model" 2>/dev/null | tr -d '\r')"
      manufacturer="$(adb_shell "getprop ro.product.manufacturer" 2>/dev/null | tr -d '\r')"
    fi
  fi
  print -r -- "\"adb\": {"
  print -r -- "  \"found\": $(json_bool found),"
  print -r -- "  \"path\": $(json_string_or_null "$adb_path"),"
  print -r -- "  \"authorized\": $(json_bool authorized),"
  print -r -- "  \"serial\": $(json_string_or_null "$serial"),"
  print -r -- "  \"manufacturer\": $(json_string_or_null "$manufacturer"),"
  print -r -- "  \"model\": $(json_string_or_null "$model")"
  print -r -- "}"
}

derive_system_state() {
  local sing_running=0 relay_running=0 dns_active=0 guard_session=0 forward_active=0

  sing_box_running && sing_running=1
  relay_running_now && relay_running=1
  dns_temp_active && dns_active=1
  [[ -s "$SYSTEM_SESSION_FILE" ]] && guard_session=1
  adb_forward_active && forward_active=1

  if (( sing_running && dns_active && (relay_running || forward_active) )); then
    print -r -- "running"
  elif (( dns_active && ! sing_running )); then
    print -r -- "needs_recover"
  elif (( sing_running || relay_running || dns_active || guard_session || forward_active )); then
    print -r -- "partial"
  else
    print -r -- "idle"
  fi
}

ensure_admin_if_interactive() {
  if (( EUID == 0 )); then
    return 0
  fi
  sudo -n true >/dev/null 2>&1 && return 0
  if [[ -t 0 ]]; then
    sudo -v
    return $?
  fi
  if [[ -n "${SUDO_ASKPASS:-}" && -x "${SUDO_ASKPASS}" ]]; then
    sudo -A -v
    return $?
  fi
  if [[ -n "${JAM_USB_SUDO_ASKPASS:-}" && -x "${JAM_USB_SUDO_ASKPASS}" ]]; then
    SUDO_ASKPASS="$JAM_USB_SUDO_ASKPASS" sudo -A -v
    return $?
  fi
  return 1
}

ensure_admin_for_system() {
  jam_usb_export_askpass

  if (( EUID == 0 )); then
    return 0
  fi
  if [[ -t 0 ]]; then
    sudo -n true >/dev/null 2>&1 && return 0
    sudo -v || return 1
    return 0
  fi
  if [[ -n "${SUDO_ASKPASS:-}" && -x "${SUDO_ASKPASS}" ]]; then
    sudo -A -v || return 1
    sudo -n true >/dev/null 2>&1 || return 1
    return 0
  fi
  return 1
}

run_privileged() {
  jam_usb_export_askpass

  if (( EUID == 0 )); then
    "$@"
    return $?
  fi
  if sudo -n "$@"; then
    return 0
  fi
  if [[ -n "${SUDO_ASKPASS:-}" && -x "${SUDO_ASKPASS}" ]]; then
    sudo -A "$@"
    return $?
  fi
  return 1
}

jam_usb_export_askpass() {
  if [[ -n "${JAM_USB_SUDO_ASKPASS:-}" && -x "${JAM_USB_SUDO_ASKPASS}" ]]; then
    export SUDO_ASKPASS="$JAM_USB_SUDO_ASKPASS"
  fi
}

clear_sudo_askpass_cache() {
  rm -f "${STATE_DIR}/.sudo-askpass-cache"
}

usage() {
  cat <<'EOF'
jam-usb-internet

MacBook + Android USB internet helper.

Usage:
  jam-usb-internet connect [options]
  jam-usb-internet proxy [options]
  jam-usb-internet browser [options]
  jam-usb-internet relay-install
  jam-usb-internet relay-start
  jam-usb-internet relay-stop
  jam-usb-internet relay-clean
  jam-usb-internet system
  jam-usb-internet system-stop
  jam-usb-internet system-recover
  jam-usb-internet system-status
  jam-usb-internet guard-check
  jam-usb-internet app-check
  jam-usb-internet proxy-stop
  jam-usb-internet status
  jam-usb-internet doctor
  jam-usb-internet restore

Common flow:
  1. Connect Galaxy Note 9 to the Mac with a data-capable USB cable.
  2. Unlock the phone.
  3. Set USB mode to File Transfer / Android Auto.
  4. Enable USB debugging once and authorize this Mac.
  5. Keep Android USB tethering off for system mode.
  6. Run: ./jam-usb-internet system

Options:
  --timeout SECONDS        Wait time for the macOS USB network interface. Default: 45
  --no-adb                Do not use ADB; you will turn on USB tethering manually.
  --no-open-settings      Do not open the Android tethering settings screen.
  --mobile-only           Ask Android to enable mobile data and disable phone Wi-Fi.
  --no-prefer             Do not move the USB tether network service to the top.
  --aggressive-android    Try extra Android USB commands that may drop ADB.
  --fallback-proxy        If native USB networking fails, start the ADB SOCKS proxy.
  --port PORT             SOCKS proxy port for the proxy command. Default: 10808
  --relay-port PORT       Mac/device relay port for system mode. Default: 18080
  --relay-binary PATH     Relay binary to install instead of auto-detected path.
  --check-only            Validate setup without starting privileged TUN mode.
  --force-tun             Start USB TUN even if normal Mac internet already works.
  --no-system-proxy       Do not change macOS system SOCKS proxy settings.
  --url URL               URL to open with the browser command.
  --verbose               Print command-level diagnostics.
  --json                  Emit machine-readable JSON (system-status, doctor).
  -h, --help              Show this help.

Commands:
  connect                 Try to bring up USB internet. This is the default.
  proxy                   Start an ADB SOCKS proxy over USB. Best for modern macOS.
  browser                 Start the proxy and open a dedicated Chrome window through it.
  relay-install           Stage 1: upload Android relay binary if available.
  relay-start             Stage 1: start Android relay and ADB forward.
  relay-stop              Stage 1: stop Android relay and remove ADB forward.
  relay-clean             Stage 1: stop and remove Android relay.
  system                  Mac-wide TUN mode.
  system-stop             Stop Mac-wide TUN mode.
  system-recover          Aggressively restore normal Mac networking.
  system-status           Show whether Mac-wide TUN mode appears to be active.
  guard-check              Validate abnormal-exit cleanup guard without changing routes/DNS.
  app-check               Check Chrome/Discord/Kakao/git-style TCP connectivity.
  proxy-stop              Turn off the macOS system SOCKS proxy set by this tool.
  status                  Print current USB/network/ADB status.
  doctor                  Check prerequisites and give next steps.
  restore                 Restore the previous macOS network service order.

Notes:
  - If cellular data is blocked, the phone relay cannot create internet.
  - On modern macOS, many Samsung/Android phones expose old RNDIS tethering,
    which macOS may not show as a network interface without a compatible driver.
EOF
}

parse_args() {
  if (( $# > 0 )) && [[ "$1" != --* && "$1" != "-h" ]]; then
    COMMAND="$1"
    shift
  fi

  while (( $# > 0 )); do
    case "$1" in
      --timeout)
        shift
        if (( $# == 0 )); then
          fail "--timeout needs a value."
          exit 2
        fi
        TIMEOUT="$1"
        ;;
      --no-adb)
        USE_ADB=0
        ;;
      --no-open-settings)
        OPEN_SETTINGS=0
        ;;
      --mobile-only)
        MOBILE_ONLY=1
        ;;
      --no-prefer)
        PREFER_TETHER=0
        ;;
      --aggressive-android)
        AGGRESSIVE_ANDROID=1
        ;;
      --fallback-proxy)
        FALLBACK_PROXY=1
        ;;
      --port)
        shift
        if (( $# == 0 )); then
          fail "--port needs a value."
          exit 2
        fi
        PROXY_PORT="$1"
        ;;
      --relay-port)
        shift
        if (( $# == 0 )); then
          fail "--relay-port needs a value."
          exit 2
        fi
        RELAY_MAC_PORT="$1"
        RELAY_DEVICE_PORT="$1"
        ;;
      --relay-binary)
        shift
        if (( $# == 0 )); then
          fail "--relay-binary needs a value."
          exit 2
        fi
        KNOCK_RELAY_BINARY="$1"
        ;;
      --check-only)
        CHECK_ONLY=1
        ;;
      --force-tun)
        FORCE_TUN=1
        ;;
      --guard-parent-pid)
        shift
        if (( $# == 0 )); then
          fail "--guard-parent-pid needs a value."
          exit 2
        fi
        GUARD_PARENT_PID="$1"
        ;;
      --guard-token)
        shift
        if (( $# == 0 )); then
          fail "--guard-token needs a value."
          exit 2
        fi
        GUARD_TOKEN="$1"
        ;;
      --no-system-proxy)
        SYSTEM_PROXY=0
        ;;
      --url)
        shift
        if (( $# == 0 )); then
          fail "--url needs a value."
          exit 2
        fi
        BROWSER_URL="$1"
        ;;
      --verbose)
        VERBOSE=1
        ;;
      --json)
        JSON_OUTPUT=1
        ;;
      -h|--help|help)
        usage
        exit 0
        ;;
      *)
        fail "Unknown option: $1"
        usage
        exit 2
        ;;
    esac
    shift
  done
}

require_macos() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    fail "This utility is for macOS."
    exit 1
  fi
}

ensure_state_dir() {
  mkdir -p "$STATE_DIR"
}

find_adb() {
  local candidate

  if command -v adb >/dev/null 2>&1; then
    command -v adb
    return 0
  fi

  for candidate in \
    "${ANDROID_HOME:-}/platform-tools/adb" \
    "${ANDROID_SDK_ROOT:-}/platform-tools/adb" \
    "${HOME}/Library/Android/sdk/platform-tools/adb" \
    "/opt/homebrew/bin/adb" \
    "/usr/local/bin/adb"; do
    if [[ -n "$candidate" && -x "$candidate" ]]; then
      print -r -- "$candidate"
      return 0
    fi
  done

  return 1
}

adb_cmd() {
  if [[ -n "$ADB_SERIAL" ]]; then
    "$ADB_BIN" -s "$ADB_SERIAL" "$@"
  else
    "$ADB_BIN" "$@"
  fi
}

adb_shell() {
  adb_cmd shell "$@"
}

start_adb_if_available() {
  if (( ! USE_ADB )); then
    return 1
  fi

  if ! ADB_BIN="$(find_adb)"; then
    return 1
  fi

  debug "Using adb: $ADB_BIN"
  "$ADB_BIN" start-server >/dev/null 2>&1 || true
  return 0
}

wait_for_adb_device() {
  local deadline=$(( SECONDS + TIMEOUT ))
  local devices authorized unauthorized offline selected
  local -a authorized_list unauthorized_list offline_list

  while (( SECONDS < deadline )); do
    devices="$("$ADB_BIN" devices 2>/dev/null | awk 'NR > 1 && NF >= 2 {print $1 "\t" $2}')"

    authorized_list=("${(@f)$(print -r -- "$devices" | awk '$2 == "device" {print $1}')}")
    unauthorized_list=("${(@f)$(print -r -- "$devices" | awk '$2 == "unauthorized" {print $1}')}")
    offline_list=("${(@f)$(print -r -- "$devices" | awk '$2 == "offline" {print $1}')}")

    if [[ -n "${ANDROID_SERIAL:-}" ]]; then
      selected="$(print -r -- "$devices" | awk -v serial="$ANDROID_SERIAL" '$1 == serial && $2 == "device" {print $1; exit}')"
      if [[ -n "$selected" ]]; then
        ADB_SERIAL="$selected"
        return 0
      fi
    elif (( ${#authorized_list[@]} > 0 )) && [[ -n "${authorized_list[1]}" ]]; then
      ADB_SERIAL="${authorized_list[1]}"
      if (( ${#authorized_list[@]} > 1 )); then
        warn "Multiple Android devices found; using ${ADB_SERIAL}. Set ANDROID_SERIAL to choose."
      fi
      return 0
    fi

    if (( ${#unauthorized_list[@]} > 0 )) && [[ -n "${unauthorized_list[1]}" ]]; then
      warn "Phone is connected but not authorized. Unlock it and tap 'Allow USB debugging'."
    elif (( ${#offline_list[@]} > 0 )) && [[ -n "${offline_list[1]}" ]]; then
      warn "Phone is visible to ADB but offline. Replug USB or toggle USB debugging."
    else
      debug "Waiting for an ADB device..."
    fi
    sleep 2
  done

  return 1
}

select_adb_device_now() {
  local devices selected

  devices="$("$ADB_BIN" devices 2>/dev/null | awk 'NR > 1 && NF >= 2 {print $1 "\t" $2}')"
  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
    selected="$(print -r -- "$devices" | awk -v serial="$ANDROID_SERIAL" '$1 == serial && $2 == "device" {print $1; exit}')"
  else
    selected="$(print -r -- "$devices" | awk '$2 == "device" {print $1; exit}')"
  fi

  if [[ -n "$selected" ]]; then
    ADB_SERIAL="$selected"
    return 0
  fi

  return 1
}

android_summary() {
  local manufacturer model release sdk
  manufacturer="$(adb_shell "getprop ro.product.manufacturer" 2>/dev/null | tr -d '\r')"
  model="$(adb_shell "getprop ro.product.model" 2>/dev/null | tr -d '\r')"
  release="$(adb_shell "getprop ro.build.version.release" 2>/dev/null | tr -d '\r')"
  sdk="$(adb_shell "getprop ro.build.version.sdk" 2>/dev/null | tr -d '\r')"
  ok "ADB connected: ${manufacturer:-Android} ${model:-device}, Android ${release:-?} / SDK ${sdk:-?} (${ADB_SERIAL})"
}

ensure_adb_device_or_fail() {
  if ! start_adb_if_available; then
    fail "ADB is required. Install with: brew install --cask android-platform-tools"
    return 1
  fi

  info "Waiting for the phone over ADB. Unlock the phone if needed."
  if ! wait_for_adb_device; then
    fail "No authorized ADB device found. Replug USB, unlock the phone, and approve USB debugging."
    return 1
  fi

  android_summary
}

android_abi() {
  adb_shell "getprop ro.product.cpu.abi" 2>/dev/null | tr -d '\r' | awk 'NF {print; exit}'
}

try_adb_shell() {
  local description="$1"
  local command_text="$2"
  local output rc

  debug "adb shell $command_text"
  output="$(adb_shell "$command_text" 2>&1)"
  rc=$?

  if (( rc == 0 )); then
    ok "$description"
    [[ -n "$output" ]] && debug "$output"
    return 0
  fi

  debug "$description failed: $output"
  return 1
}

open_android_tether_settings() {
  if (( ! OPEN_SETTINGS )); then
    return 0
  fi

  if try_adb_shell "Opened Android tethering settings on the phone." "am start -a android.settings.TETHER_SETTINGS"; then
    return 0
  fi

  try_adb_shell "Opened Android wireless settings on the phone." "am start -a android.settings.WIRELESS_SETTINGS" || true
}

try_android_tethering() {
  local tried=0

  if (( MOBILE_ONLY )); then
    info "Asking the phone to prefer cellular data."
    try_adb_shell "Mobile data enable command sent." "svc data enable" || true
    try_adb_shell "Phone Wi-Fi disable command sent." "svc wifi disable" || true
  fi

  info "Trying Android-side USB tethering commands."
  try_adb_shell "Requested USB tethering through Android connectivity service." "cmd connectivity tether start usb" && tried=1
  try_adb_shell "Requested RNDIS tethering through Android connectivity service." "cmd connectivity tether start rndis" && tried=1
  try_adb_shell "Set USB function to rndis,adb." "svc usb setFunctions rndis,adb" && tried=1
  try_adb_shell "Set USB function to rndis,adb using old syntax." "svc usb setFunction rndis,adb true" && tried=1

  if (( AGGRESSIVE_ANDROID )); then
    warn "Trying aggressive Android USB commands. ADB may disconnect if one succeeds."
    try_adb_shell "Set USB function to rndis." "svc usb setFunctions rndis" && tried=1
    try_adb_shell "Set sys.usb.config to rndis,adb." "setprop sys.usb.config rndis,adb" && tried=1
  fi

  open_android_tether_settings

  if (( tried )); then
    info "If the phone asks for confirmation, unlock it and allow USB tethering."
  else
    warn "Automatic tethering commands were not accepted. Turn on 'USB tethering' on the phone screen."
  fi
}

network_snapshot() {
  networksetup -listnetworkserviceorder 2>/dev/null | awk '
    /^\([0-9]+\) / {
      service = $0
      sub(/^\([0-9]+\) /, "", service)
      next
    }
    /Hardware Port: / && service != "" {
      line = $0
      sub(/^.*Hardware Port: /, "", line)
      split(line, parts, ", Device: ")
      port = parts[1]
      device = parts[2]
      sub(/\).*$/, "", device)
      print service "\t" port "\t" device
      service = ""
    }
  '
}

hardware_snapshot() {
  networksetup -listallhardwareports 2>/dev/null | awk '
    /^Hardware Port: / {
      port = $0
      sub(/^Hardware Port: /, "", port)
      next
    }
    /^Device: / {
      device = $0
      sub(/^Device: /, "", device)
      next
    }
    /^Ethernet Address: / && port != "" && device != "" {
      mac = $0
      sub(/^Ethernet Address: /, "", mac)
      print port "\t" device "\t" mac
      port = ""
      device = ""
    }
  '
}

all_network_services() {
  networksetup -listallnetworkservices 2>/dev/null | sed '1d;s/^\*//'
}

active_network_services() {
  networksetup -listnetworkserviceorder 2>/dev/null | awk '
    /^\([0-9]+\) / {
      service = $0
      sub(/^\([0-9]+\) /, "", service)
      print service
    }
  '
}

service_ip() {
  networksetup -getinfo "$1" 2>/dev/null | awk -F': ' '/^IP address:/ {print $2; exit}'
}

service_router() {
  networksetup -getinfo "$1" 2>/dev/null | awk -F': ' '/^Router:/ {print $2; exit}'
}

is_skippable_network() {
  local text="${1:l} ${2:l} ${3:l}"
  [[ "$text" == *"wi-fi"* || "$text" == *"wifi"* || "$text" == *"thunderbolt"* || "$text" == *"bridge"* ]]
}

find_candidate_service() {
  local before_file="$1"
  local after_file="$2"
  local line service port device ip router text

  line="$(awk -F '\t' '
    NR == FNR { old[$1] = 1; next }
    {
      text = tolower($1 " " $2 " " $3)
      if (text ~ /(wi-fi|wifi|thunderbolt|bridge)/) next
      if (!old[$1]) { print $0; exit }
    }
  ' "$before_file" "$after_file")"
  if [[ -n "$line" ]]; then
    print -r -- "$line"
    return 0
  fi

  line="$(awk -F '\t' '
    {
      text = tolower($1 " " $2 " " $3)
      if (text ~ /(wi-fi|wifi|thunderbolt|bridge)/) next
      if (text ~ /(android|samsung|galaxy|rndis|horndis|ncm|cdc)/) { print $0; exit }
    }
  ' "$after_file")"
  if [[ -n "$line" ]]; then
    print -r -- "$line"
    return 0
  fi

  while IFS=$'\t' read -r service port device; do
    [[ -z "$service" ]] && continue
    is_skippable_network "$service" "$port" "$device" && continue
    ip="$(service_ip "$service")"
    router="$(service_router "$service")"
    text="$ip $router"
    if [[ "$text" == *"192.168.42."* || "$text" == *"192.168.43."* || "$text" == *"192.168.44."* || "$text" == *"172.20.10."* ]]; then
      print -r -- "${service}\t${port}\t${device}"
      return 0
    fi
  done < "$after_file"

  return 1
}

find_candidate_hardware() {
  local before_file="$1"
  local after_file="$2"
  local line

  line="$(awk -F '\t' '
    NR == FNR { old[$1 "\t" $2] = 1; next }
    {
      text = tolower($1 " " $2 " " $3)
      if (text ~ /(wi-fi|wifi|thunderbolt|bridge)/) next
      if (!old[$1 "\t" $2]) { print $0; exit }
    }
  ' "$before_file" "$after_file")"
  if [[ -n "$line" ]]; then
    print -r -- "$line"
    return 0
  fi

  line="$(awk -F '\t' '
    {
      text = tolower($1 " " $2 " " $3)
      if (text ~ /(wi-fi|wifi|thunderbolt|bridge)/) next
      if (text ~ /(android|samsung|galaxy|rndis|horndis|ncm|cdc)/) { print $0; exit }
    }
  ' "$after_file")"
  if [[ -n "$line" ]]; then
    print -r -- "$line"
    return 0
  fi

  return 1
}

service_line_for_device() {
  local snapshot_file="$1"
  local device="$2"
  awk -F '\t' -v device="$device" '$3 == device { print $0; exit }' "$snapshot_file"
}

create_network_service_for_hardware() {
  local port="$1"
  local device="$2"
  local service_name="Android USB Tether ${device}"
  local output rc

  if all_network_services | grep -Fxq "$service_name"; then
    print -r -- "$service_name"
    return 0
  fi

  info "Creating macOS network service '$service_name' for hardware port '$port'."
  output="$(networksetup -createnetworkservice "$service_name" "$port" 2>&1)"
  rc=$?
  if (( rc == 0 )); then
    ok "Created network service '$service_name'."
    print -r -- "$service_name"
    return 0
  fi

  warn "Could not create network service for '$port'. macOS may require admin rights or may not support this hardware."
  debug "$output"
  return 1
}

backup_service_order_once() {
  ensure_state_dir
  if [[ ! -s "$ORDER_BACKUP" ]]; then
    all_network_services > "$ORDER_BACKUP"
    ok "Saved current network service order: $ORDER_BACKUP"
  fi
}

prefer_network_service() {
  local service="$1"
  local -a services reordered
  local item output rc

  (( PREFER_TETHER )) || return 0

  services=("${(@f)$(all_network_services)}")
  reordered=("$service")

  for item in "${services[@]}"; do
    [[ "$item" == "$service" ]] && continue
    [[ -z "$item" ]] && continue
    reordered+=("$item")
  done

  if (( ${#reordered[@]} < 2 )); then
    return 0
  fi

  backup_service_order_once
  output="$(networksetup -ordernetworkservices "${reordered[@]}" 2>&1)"
  rc=$?
  if (( rc == 0 )); then
    ok "Moved '$service' to the top of macOS network service order."
  else
    warn "Could not change service order. macOS may ask for admin rights."
    debug "$output"
  fi
}

configure_network_service() {
  local service="$1"
  local device="$2"
  local output rc

  info "Configuring macOS network service: $service (${device:-no-device})"

  networksetup -setnetworkserviceenabled "$service" on >/dev/null 2>&1 || true

  output="$(networksetup -setdhcp "$service" 2>&1)"
  rc=$?
  if (( rc == 0 )); then
    ok "DHCP enabled on '$service'."
  else
    warn "Could not set DHCP on '$service'."
    debug "$output"
  fi

  if [[ -n "$device" ]]; then
    ifconfig "$device" up >/dev/null 2>&1 || true
    ipconfig set "$device" DHCP >/dev/null 2>&1 || true
  fi

  prefer_network_service "$service"
}

connectivity_check() {
  local route_interface route_gateway

  route_interface="$(route -n get default 2>/dev/null | awk '/interface:/ {print $2; exit}')"
  route_gateway="$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2; exit}')"

  if [[ -n "$route_interface" ]]; then
    info "Default route: interface=${route_interface}, gateway=${route_gateway:-unknown}"
  else
    warn "No default route is currently configured."
  fi

  if curl -fsS --max-time 6 https://connectivitycheck.gstatic.com/generate_204 >/dev/null 2>&1; then
    ok "Internet check succeeded over HTTPS."
    return 0
  fi

  if ping -c 1 -W 2000 1.1.1.1 >/dev/null 2>&1; then
    ok "Internet check succeeded with ICMP."
    return 0
  fi

  warn "Internet check failed. The interface may still be acquiring IP/DNS, or cellular data may be unavailable."
  return 1
}

wait_for_mac_usb_network() {
  local before_file="$1"
  local before_hardware_file="$2"
  local after_file after_hardware_file line hardware_line service port device ip router created_service
  local i j

  after_file="$(mktemp "${TMPDIR:-/tmp}/jam-usb-after.XXXXXX")"
  after_hardware_file="$(mktemp "${TMPDIR:-/tmp}/jam-usb-hw-after.XXXXXX")"

  info "Waiting for macOS to expose a USB network interface (${TIMEOUT}s)."
  for (( i = 1; i <= TIMEOUT; i++ )); do
    networksetup -detectnewhardware >/dev/null 2>&1 || true
    network_snapshot > "$after_file"
    hardware_snapshot > "$after_hardware_file"

    if line="$(find_candidate_service "$before_file" "$after_file")"; then
      service="$(print -r -- "$line" | cut -f1)"
      port="$(print -r -- "$line" | cut -f2)"
      device="$(print -r -- "$line" | cut -f3)"
      ok "Found likely USB internet service: $service / $port / $device"
      configure_network_service "$service" "$device"

      for (( j = 1; j <= 15; j++ )); do
        ip="$(service_ip "$service")"
        router="$(service_router "$service")"
        if [[ -n "$ip" && "$ip" != "none" ]]; then
          ok "IP acquired on '$service': ${ip}, router=${router:-unknown}"
          break
        fi
        sleep 1
      done

      connectivity_check
      rm -f "$after_file" "$after_hardware_file"
      return 0
    fi

    if hardware_line="$(find_candidate_hardware "$before_hardware_file" "$after_hardware_file")"; then
      port="$(print -r -- "$hardware_line" | cut -f1)"
      device="$(print -r -- "$hardware_line" | cut -f2)"
      ok "Found likely USB tether hardware: $port / $device"

      if created_service="$(create_network_service_for_hardware "$port" "$device")"; then
        networksetup -detectnewhardware >/dev/null 2>&1 || true
        network_snapshot > "$after_file"
        line="$(service_line_for_device "$after_file" "$device")"
        if [[ -n "$line" ]]; then
          service="$(print -r -- "$line" | cut -f1)"
        else
          service="$created_service"
        fi

        configure_network_service "$service" "$device"

        for (( j = 1; j <= 15; j++ )); do
          ip="$(service_ip "$service")"
          router="$(service_router "$service")"
          if [[ -n "$ip" && "$ip" != "none" ]]; then
            ok "IP acquired on '$service': ${ip}, router=${router:-unknown}"
            break
          fi
          sleep 1
        done

        connectivity_check
        rm -f "$after_file" "$after_hardware_file"
        return 0
      fi
    fi

    sleep 1
  done

  rm -f "$after_file" "$after_hardware_file"
  return 1
}

print_usb_hint() {
  local usb_matches ioreg_matches
  usb_matches="$(system_profiler SPUSBDataType 2>/dev/null | grep -Ei 'samsung|galaxy|android|rndis|ncm|cdc' || true)"
  if [[ -n "$usb_matches" ]]; then
    info "USB device hints seen by macOS:"
    print -r -- "$usb_matches" | sed 's/^/  /'
    return 0
  fi

  ioreg_matches="$(ioreg -p IOUSB -w0 -l -r -c IOUSBHostDevice 2>/dev/null | grep -Ei 'SAMSUNG_Android|Android|Galaxy|RNDIS|NCM|CDC|USB Product Name|USB Vendor Name|kUSBSerialNumberString|idVendor|idProduct' | sed -n '1,80p' || true)"
  if [[ -z "$ioreg_matches" ]]; then
    ioreg_matches="$(ioreg -p IOUSBHost -w0 -l -r -c IOUSBHostDevice 2>/dev/null | grep -Ei 'SAMSUNG_Android|Android|Galaxy|RNDIS|NCM|CDC|USB Product Name|USB Vendor Name|kUSBSerialNumberString|idVendor|idProduct' | sed -n '1,80p' || true)"
  fi

  if [[ -n "$ioreg_matches" ]]; then
    info "USB device hints seen by macOS ioreg:"
    print -r -- "$ioreg_matches" | sed 's/^/  /'
  else
    warn "macOS did not report an obvious Samsung/Android USB device."
  fi
}

connect_command() {
  local before_file before_hardware_file

  require_macos
  say "${BOLD}${APP_NAME} ${VERSION}${RESET}"
  info "Mac: $(sw_vers -productName) $(sw_vers -productVersion), $(uname -m)"

  before_file="$(mktemp "${TMPDIR:-/tmp}/jam-usb-before.XXXXXX")"
  before_hardware_file="$(mktemp "${TMPDIR:-/tmp}/jam-usb-hw-before.XXXXXX")"
  network_snapshot > "$before_file"
  hardware_snapshot > "$before_hardware_file"

  if start_adb_if_available; then
    info "Waiting for the phone over ADB. Unlock the phone if needed."
    if wait_for_adb_device; then
      android_summary
      try_android_tethering
    else
      warn "No authorized ADB device found within ${TIMEOUT}s."
      warn "You can still turn on USB tethering manually on the phone."
    fi
  else
    warn "ADB is not available. Manual phone-side setup is required."
    warn "Install later with: brew install --cask android-platform-tools"
  fi

  info "If the phone screen is open, enable: Settings > Connections > Mobile Hotspot and Tethering > USB tethering."

  if wait_for_mac_usb_network "$before_file" "$before_hardware_file"; then
    rm -f "$before_file" "$before_hardware_file"
    return 0
  fi

  fail "No usable USB network interface appeared on macOS."
  print_usb_hint

  if (( FALLBACK_PROXY )); then
    warn "Native USB networking did not come up. Starting ADB SOCKS proxy fallback."
    proxy_command
    return $?
  fi

  say ""
  warn "Likely causes:"
  say "  1. USB tethering is not enabled on the phone."
  say "  2. The cable is charge-only, not data-capable."
  say "  3. Cellular data is unavailable."
  say "  4. macOS does not support the phone's native USB tethering mode."
  say ""
  say "Next best actions:"
  say "  - On the phone, turn on USB tethering manually and run this again."
  say "  - Enable Developer options > Default USB configuration > USB tethering, if your Note 9 shows it."
  say "  - Run './jam-usb-internet doctor' for a concise checklist."

  rm -f "$before_file" "$before_hardware_file"
  return 1
}

save_socks_state_once() {
  local service enabled server port

  ensure_state_dir
  if [[ -s "$SOCKS_BACKUP" ]]; then
    return 0
  fi

  : > "$SOCKS_BACKUP"
  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    enabled="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Enabled:/ {print $2; exit}')"
    server="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Server:/ {print $2; exit}')"
    port="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Port:/ {print $2; exit}')"
    print -r -- "${service}\t${enabled:-No}\t${server:-}\t${port:-0}" >> "$SOCKS_BACKUP"
  done < <(all_network_services)

  ok "Saved current SOCKS proxy settings: $SOCKS_BACKUP"
}

enable_system_socks_proxy() {
  local service output rc

  (( SYSTEM_PROXY )) || return 0
  save_socks_state_once

  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    output="$(networksetup -setsocksfirewallproxy "$service" "$PROXY_HOST" "$PROXY_PORT" 2>&1)"
    rc=$?
    if (( rc != 0 )); then
      warn "Could not set SOCKS proxy on '$service'."
      debug "$output"
      continue
    fi
    networksetup -setsocksfirewallproxystate "$service" on >/dev/null 2>&1 || true
    ok "Enabled SOCKS proxy on '$service' -> ${PROXY_HOST}:${PROXY_PORT}"
  done < <(all_network_services)
}

restore_system_socks_proxy() {
  local service enabled server port

  if [[ ! -s "$SOCKS_BACKUP" ]]; then
    debug "No SOCKS proxy backup found; skipping SOCKS restore."
    return 0
  fi

  while IFS=$'\t' read -r service enabled server port; do
    [[ -z "$service" ]] && continue
    if [[ "$enabled" == "Yes" && "$server" == "$PROXY_HOST" && "$port" == "$PROXY_PORT" ]]; then
      networksetup -setsocksfirewallproxystate "$service" off >/dev/null 2>&1 || true
    elif [[ "$enabled" == "Yes" && -n "$server" && "$port" != "0" ]]; then
      networksetup -setsocksfirewallproxy "$service" "$server" "$port" >/dev/null 2>&1 || true
      networksetup -setsocksfirewallproxystate "$service" on >/dev/null 2>&1 || true
    else
      networksetup -setsocksfirewallproxystate "$service" off >/dev/null 2>&1 || true
    fi
  done < "$SOCKS_BACKUP"

  rm -f "$SOCKS_BACKUP"
  ok "Restored previous SOCKS proxy settings."
}

repair_stale_local_socks_proxy() {
  local service enabled server port
  local repaired=0

  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    enabled="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Enabled:/ {print $2; exit}')"
    server="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Server:/ {print $2; exit}')"
    port="$(networksetup -getsocksfirewallproxy "$service" 2>/dev/null | awk -F': ' '/^Port:/ {print $2; exit}')"

    if [[ "$enabled" == "Yes" && "$server" == "$PROXY_HOST" && ( "$port" == "$PROXY_PORT" || "$port" == "$RELAY_MAC_PORT" ) ]]; then
      warn "Detected stale local SOCKS proxy on '$service'; turning it off."
      networksetup -setsocksfirewallproxystate "$service" off >/dev/null 2>&1 ||
        run_privileged networksetup -setsocksfirewallproxystate "$service" off >/dev/null 2>&1 || true
      repaired=1
    fi
  done < <(all_network_services)

  if (( repaired )); then
    ok "Repaired stale local SOCKS proxy settings."
  fi
}

set_dns_servers_for_service() {
  local service="$1"
  local output rc
  shift

  if (( EUID == 0 )); then
    output="$(networksetup -setdnsservers "$service" "$@" 2>&1)"
    rc=$?
    if (( rc == 0 )); then
      return 0
    fi

    warn "Could not set DNS on '$service': $output"
    return "$rc"
  fi

  output="$(run_privileged networksetup -setdnsservers "$service" "$@" 2>&1)"
  rc=$?
  if (( rc == 0 )); then
    return 0
  fi

  warn "Could not set DNS on '$service': $output"
  return "$rc"
}

dns_servers_for_service() {
  local service="$1"
  networksetup -getdnsservers "$service" 2>/dev/null | sed "/There aren't any DNS Servers/d"
}

dns_servers_are_local_only() {
  local servers="$1"
  local line seen=0

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    seen=1
    case "$line" in
      127.0.0.1|::1|localhost)
        ;;
      *)
        return 1
        ;;
    esac
  done <<< "$servers"

  (( seen ))
}

save_dns_state_once() {
  local service dns

  ensure_state_dir
  if [[ -s "$DNS_BACKUP" ]]; then
    return 0
  fi

  : > "$DNS_BACKUP"
  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    dns="$(dns_servers_for_service "$service" | paste -sd, -)"
    [[ -z "$dns" ]] && dns="__EMPTY__"
    print -r -- "${service}"$'\t'"${dns}" >> "$DNS_BACKUP"
  done < <(all_network_services)

  ok "Saved current DNS settings: $DNS_BACKUP"
}

enable_local_system_dns() {
  local service
  local failed=0

  repair_stale_local_dns || return 1
  save_dns_state_once
  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    if set_dns_servers_for_service "$service" 127.0.0.1; then
      ok "Set DNS on '$service' -> 127.0.0.1"
    else
      warn "Could not set DNS on '$service'."
      failed=1
    fi
  done < <(all_network_services)

  (( failed == 0 ))
}

restore_system_dns() {
  local line service dns current
  local failed=0
  local -a servers

  if [[ ! -s "$DNS_BACKUP" ]]; then
    repair_stale_local_dns
    return 0
  fi

  while IFS= read -r line; do
    if [[ "$line" == *"\\t"* ]]; then
      service="${line%%\\t*}"
      dns="${line#*\\t}"
    else
      service="${line%%$'\t'*}"
      dns="${line#*$'\t'}"
    fi
    [[ -z "$service" ]] && continue
    if [[ "$service" == "$dns" ]]; then
      warn "Skipping malformed DNS backup line: $line"
      failed=1
      continue
    fi

    current="$(dns_servers_for_service "$service" | paste -sd, -)"
    if [[ "$dns" == "__EMPTY__" ]]; then
      if [[ -z "$current" ]]; then
        continue
      fi
      if ! set_dns_servers_for_service "$service" Empty; then
        warn "Could not restore DNS on '$service' to DHCP/empty."
        failed=1
      fi
    else
      if [[ "$current" == "$dns" ]]; then
        continue
      fi
      servers=("${(@s:,:)dns}")
      if ! set_dns_servers_for_service "$service" "${servers[@]}"; then
        warn "Could not restore DNS on '$service' to: ${servers[*]}"
        failed=1
      fi
    fi
  done < "$DNS_BACKUP"

  if (( failed )); then
    warn "DNS backup kept for recovery: $DNS_BACKUP"
    return 1
  fi

  rm -f "$DNS_BACKUP"
  ok "Restored previous DNS settings."
}

repair_stale_local_dns() {
  local service servers
  local repaired=0 failed=0

  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    servers="$(dns_servers_for_service "$service")"
    if dns_servers_are_local_only "$servers"; then
      warn "Detected stale local DNS on '$service'; restoring DHCP/empty DNS."
      if set_dns_servers_for_service "$service" Empty; then
        repaired=1
      else
        warn "Could not repair stale DNS on '$service'."
        failed=1
      fi
    fi
  done < <(all_network_services)

  if (( repaired )); then
    dscacheutil -flushcache >/dev/null 2>&1 || true
    ok "Repaired stale local DNS settings."
  fi

  (( failed == 0 ))
}

run_scutil_as_root() {
  if (( EUID == 0 )); then
    scutil
  else
    run_privileged scutil
  fi
}

enable_dynamic_local_dns() {
  local output rc

  setopt localoptions pipefail
  output="$({
      print -r -- "d.init"
      print -r -- "d.add ServerAddresses * 127.0.0.1"
      print -r -- "d.add SupplementalMatchDomains * \"\""
      print -r -- "d.add SupplementalMatchOrders * 1"
      print -r -- "d.add SearchOrder # 1"
      print -r -- "set ${DYNAMIC_DNS_KEY}"
      print -r -- "quit"
    } | run_scutil_as_root 2>&1)"
  rc=$?

  if (( rc != 0 )); then
    warn "Could not install temporary macOS DNS resolver."
    debug "$output"
    return "$rc"
  fi

  dscacheutil -flushcache >/dev/null 2>&1 || true
  ok "Installed temporary macOS DNS resolver -> 127.0.0.1"
}

disable_dynamic_local_dns() {
  local output

  setopt localoptions pipefail
  output="$({
      print -r -- "remove ${DYNAMIC_DNS_KEY}"
      print -r -- "quit"
    } | run_scutil_as_root 2>&1)" || debug "$output"

  dscacheutil -flushcache >/dev/null 2>&1 || true
}

wait_for_macos_resolver() {
  local i

  for (( i = 1; i <= 12; i++ )); do
    if dscacheutil -q host -a name example.com 2>/dev/null | grep -q "ip_address"; then
      return 0
    fi
    sleep 0.5
  done

  return 1
}

proxy_command() {
  local python_bin proxy_script

  require_macos
  ensure_state_dir

  if ! start_adb_if_available; then
    fail "ADB is required for proxy mode. Install with: brew install --cask android-platform-tools"
    return 1
  fi

  info "Waiting for the phone over ADB. Unlock the phone if needed."
  if ! wait_for_adb_device; then
    fail "No authorized ADB device found. Replug USB, unlock the phone, and approve USB debugging."
    return 1
  fi

  android_summary

  if (( MOBILE_ONLY )); then
    info "Asking the phone to prefer cellular data."
    try_adb_shell "Mobile data enable command sent." "svc data enable" || true
    try_adb_shell "Phone Wi-Fi disable command sent." "svc wifi disable" || true
  fi

  if ! adb_shell "command -v nc" >/dev/null 2>&1; then
    fail "The phone does not expose /system/bin/nc, so app-free proxy mode is unavailable."
    return 1
  fi

  if command -v python3 >/dev/null 2>&1; then
    python_bin="$(command -v python3)"
  else
    fail "python3 is required for proxy mode."
    return 1
  fi

  proxy_script="${SCRIPT_DIR}/adb-socks-proxy.py"
  if [[ ! -f "$proxy_script" ]]; then
    fail "Proxy script not found: $proxy_script"
    return 1
  fi

  enable_system_socks_proxy

  say ""
  ok "ADB SOCKS proxy is starting on ${PROXY_HOST}:${PROXY_PORT}"
  info "Keep this terminal window open while using the connection."
  info "To stop and restore proxy settings later: ./jam-usb-internet proxy-stop"
  say ""

  trap 'restore_system_socks_proxy' INT TERM HUP EXIT
  "$python_bin" "$proxy_script" --host "$PROXY_HOST" --port "$PROXY_PORT" --adb "$ADB_BIN" --serial "$ADB_SERIAL"
}

wait_for_proxy_port() {
  local i
  for (( i = 1; i <= 50; i++ )); do
    if command -v nc >/dev/null 2>&1 && nc -z "$PROXY_HOST" "$PROXY_PORT" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

launch_chrome_with_proxy() {
  local chrome_app chrome_bin profile_dir

  chrome_app="/Applications/Google Chrome.app"
  chrome_bin="${chrome_app}/Contents/MacOS/Google Chrome"
  profile_dir="${STATE_DIR}/chrome-proxy-profile"

  if [[ ! -x "$chrome_bin" ]]; then
    fail "Google Chrome is not installed at ${chrome_app}."
    return 1
  fi

  mkdir -p "$profile_dir"

  ok "Opening Chrome through SOCKS proxy ${PROXY_HOST}:${PROXY_PORT}"
  open -na "$chrome_app" --args \
    "--user-data-dir=${profile_dir}" \
    "--proxy-server=socks5://${PROXY_HOST}:${PROXY_PORT}" \
    "--host-resolver-rules=MAP * ~NOTFOUND, EXCLUDE localhost, EXCLUDE 127.0.0.1" \
    "$BROWSER_URL"
}

browser_command() {
  local python_bin proxy_script proxy_pid

  require_macos
  ensure_state_dir
  SYSTEM_PROXY=0

  if ! start_adb_if_available; then
    fail "ADB is required for browser mode. Install with: brew install --cask android-platform-tools"
    return 1
  fi

  info "Waiting for the phone over ADB. Unlock the phone if needed."
  if ! wait_for_adb_device; then
    fail "No authorized ADB device found. Replug USB, unlock the phone, and approve USB debugging."
    return 1
  fi

  android_summary

  if (( MOBILE_ONLY )); then
    info "Asking the phone to prefer cellular data."
    try_adb_shell "Mobile data enable command sent." "svc data enable" || true
    try_adb_shell "Phone Wi-Fi disable command sent." "svc wifi disable" || true
  fi

  if ! adb_shell "command -v nc" >/dev/null 2>&1; then
    fail "The phone does not expose /system/bin/nc, so app-free browser mode is unavailable."
    return 1
  fi

  if command -v python3 >/dev/null 2>&1; then
    python_bin="$(command -v python3)"
  else
    fail "python3 is required for browser mode."
    return 1
  fi

  proxy_script="${SCRIPT_DIR}/adb-socks-proxy.py"
  if [[ ! -f "$proxy_script" ]]; then

system_command() {
  local sing_box_bin template monitor_pid

  require_macos
  ensure_state_dir
  jam_usb_export_askpass
  SYSTEM_MODE_CLEANED_UP=0

  if command -v sing-box >/dev/null 2>&1; then
    sing_box_bin="$(command -v sing-box)"
  else
    fail "sing-box is required for system mode. Install with: brew install sing-box"
    return 1
  fi

  if (( ! CHECK_ONLY )); then
    if (( EUID != 0 )); then
      if ! ensure_admin_for_system; then
        fail "Administrator permission is required for system mode."
        return 1
      fi
      ok "Administrator credentials cached for this session."
    fi
    preclean_system_mode
    if (( ! FORCE_TUN )) && quick_internet_check; then
      ok "Normal Mac internet is already working. USB TUN was not started."
      info "This preserves Mac Wi-Fi when the phone has no internet."
      info "Use --force-tun only for a deliberate USB-path test."
      return 0
    fi
  fi

  relay_install_command || return 1
  prepare_android_system_internet
  relay_start_command || return 1

  if curl --socks5-hostname "127.0.0.1:${RELAY_MAC_PORT}" --max-time 10 -fsSI https://example.com >/dev/null 2>&1; then
    ok "Relay health check succeeded through 127.0.0.1:${RELAY_MAC_PORT}"
  else
    fail "Relay health check failed through 127.0.0.1:${RELAY_MAC_PORT}"
    relay_stop_command || true
    return 1
  fi

  if ! relay_network_check; then
    fail "Android relay is running, but app-style relay connectivity failed."
    relay_stop_command || true
    return 1
  fi

  template="${SCRIPT_DIR}/configs/sing-box.template.json"
  if [[ ! -f "$template" ]]; then
    fail "Missing sing-box template: $template"
    relay_stop_command || true
    return 1
  fi

  sed -e "s/\"server_port\": 18080/\"server_port\": ${RELAY_MAC_PORT}/" "$template" > "$SING_BOX_CONFIG"
  "$sing_box_bin" check -c "$SING_BOX_CONFIG" || {
    fail "Generated sing-box config failed validation: $SING_BOX_CONFIG"
    relay_stop_command || true
    return 1
  }

  if (( CHECK_ONLY )); then
    ok "System mode check passed. Generated config: $SING_BOX_CONFIG"
    relay_stop_command || true
    return 0
  fi

  say ""
  ok "System mode is ready to start."
  info "TUN routing and local DNS setup need macOS administrator permission."
  info "Keep this terminal open. Press Ctrl-C to stop and clean up."
  say ""

  trap 'system_mode_cleanup normal' INT EXIT
  trap 'system_mode_cleanup abnormal' TERM HUP

  if ! start_system_guard; then
    fail "Could not start abnormal-exit cleanup guard; refusing to modify TUN routes/DNS."
    system_mode_cleanup
    return 1
  fi

  if ! start_sing_box_engine "$sing_box_bin"; then
    system_mode_cleanup
    return 1
  fi

  if [[ ! -s "$SING_BOX_PID_FILE" ]]; then
    fail "sing-box pid file missing after start."
    system_mode_cleanup
    return 1
  fi

  if ! wait_for_tun_gateway; then
    fail "TUN gateway ${TUN_GATEWAY} did not appear."
    system_mode_cleanup
    return 1
  fi

  if ! install_manual_tun_routes; then
    system_mode_cleanup
    return 1
  fi
  if ! wait_for_local_dns; then
    fail "Local DNS at 127.0.0.1 did not answer. Refusing to change macOS DNS."
    system_mode_cleanup
    return 1
  fi

  if ! enable_dynamic_local_dns; then
    fail "Could not install temporary macOS DNS safely."
    system_mode_cleanup
    return 1
  fi

  if ! wait_for_macos_resolver; then
    fail "macOS resolver did not use the temporary local DNS."
    system_mode_cleanup
    return 1
  fi

  if ! basic_network_check system; then
    fail "System mode started, but app connectivity checks failed. Cleaning up."
    system_mode_cleanup
    return 1
  fi

  ok "System mode is running. Test with: curl https://example.com"
  monitor_phone_relay &
  monitor_pid=$!
  wait_for_sing_box_exit
  kill "$monitor_pid" >/dev/null 2>&1 || true
}

system_stop_command() {

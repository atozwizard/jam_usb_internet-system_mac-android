restore_command() {
  local -a services
  local output rc

  require_macos
  if [[ ! -s "$ORDER_BACKUP" ]]; then
    warn "No saved network service order found at $ORDER_BACKUP"
    return 1
  fi

  services=("${(@f)$(< "$ORDER_BACKUP")}")
  if (( ${#services[@]} == 0 )); then
    fail "Saved service order is empty."
    return 1
  fi

  output="$(networksetup -ordernetworkservices "${services[@]}" 2>&1)"
  rc=$?
  if (( rc == 0 )); then
    ok "Restored network service order from $ORDER_BACKUP"
  else
    fail "Could not restore network service order."
    debug "$output"
    return "$rc"
  fi
}

